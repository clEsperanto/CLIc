@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# GPU backend CLIc was compiled for: OPENCL, CUDA or METAL
set(CLIc_BACKEND "@CLE_BACKEND@")

# dependencies of the CLIc::CLIc target
find_dependency(cleKernels)
find_dependency(Eigen3)
if(CLIc_BACKEND STREQUAL "OPENCL")
    find_dependency(OpenCL)
elseif(CLIc_BACKEND STREQUAL "CUDA")
    find_dependency(CUDAToolkit)
endif()

if(NOT TARGET CLIc::CLIc)
    include("${CMAKE_CURRENT_LIST_DIR}/CLIcTargets.cmake")
endif()

set(CLIC_LIBRARIES CLIc::CLIc)

check_required_components(CLIc)
